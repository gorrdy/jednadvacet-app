# Copy to `.env` and fill in. Never commit `.env` (already gitignored).

# ── HTTP server ─────────────────────────────────────────────
PORT=3021
HOST=127.0.0.1

# ── Web Push (VAPID) ────────────────────────────────────────
# Generate keys once via:  npm run keys
VAPID_PUBLIC=
VAPID_PRIVATE=
VAPID_SUBJECT=mailto:admin@example.com

# ── Database ────────────────────────────────────────────────
DB_PATH=./db.sqlite3

# ── Bootstrap superadmin (only used on first boot if no admins exist) ──
# After the first login you should rotate the password from the admin UI.
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=replace-me-with-a-strong-password

# ── Sessions / invites ──────────────────────────────────────
SESSION_TTL_DAYS=30
INVITE_TTL_DAYS=14

# ── Calendar (ICS) ingest — optional ────────────────────────
# Public iCalendar feed; leave empty to disable. Example: a Google Calendar
# "Public iCal" URL ending in /public/basic.ics
ICS_URL=
ICS_INTERVAL_MS=900000

# ── RSS aggregator — optional ───────────────────────────────
# Comma-separated `name|url` pairs. Leaving unset uses the bundled defaults
# (currently CZ Bitcoin sources). Each feed is fetched independently.
#   RSS_FEEDS="KryptoHodler|https://kryptohodler.cz/feed/,Source 2|https://example.com/feed/"
RSS_FEEDS=
RSS_INTERVAL_MS=900000

# ── Daily "tomorrow's events" push reminder ─────────────────
# Hour 0–23 in REMINDER_TZ. Set REMINDER_HOUR= (empty) to disable.
REMINDER_HOUR=18
REMINDER_TZ=Europe/Prague
