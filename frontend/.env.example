# Copy to `.env.local` (or `.env`) and tweak. Never commit local env files.

# ── Evolu sync ──────────────────────────────────────────────
# Comma-separated list of WebSocket relay URLs the client syncs end-to-end
# encrypted personal data through. Multiple relays = redundancy (Evolu fans
# out to all in parallel). For a fork running its own infra, point this at
# your own evolu-relay deployment(s).
#
#   VITE_EVOLU_RELAYS=wss://relay1.example.com,wss://relay2.example.com
VITE_EVOLU_RELAYS=

# Evolu instance namespace. Acts as the OPFS database name in the user's
# browser AND the namespace bucket on relays. Staging builds override this
# to `jednadvacet-test` so test data never collides with production even
# on the same device.
#
# This is NOT a secret — Vite bundles every `VITE_*` value into the public
# JS bundle, so anyone can read it from view-source. Don't randomize it.
# Use a stable, human-readable name (e.g. `jednadvacet-myfork` for a
# personal fork). Cryptographic isolation between users comes from the
# 24-word BIP-39 mnemonic + E2E encryption, not from this string.
#
# Changing it later means existing users get a fresh empty OPFS database
# (their old data still lives on the relay under the previous namespace,
# but the client looks in the new one). Pick a name and stick with it.
VITE_EVOLU_INSTANCE=jednadvacet
