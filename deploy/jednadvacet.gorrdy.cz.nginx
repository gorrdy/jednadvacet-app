# /etc/nginx/sites-available/jednadvacet.gorrdy.cz
# After placing this file, symlink into sites-enabled, run certbot, reload nginx.
#
#   sudo ln -s /etc/nginx/sites-available/jednadvacet.gorrdy.cz /etc/nginx/sites-enabled/
#   sudo certbot --nginx -d jednadvacet.gorrdy.cz
#   sudo systemctl reload nginx
#
# COOP/COEP headers are required for OPFS (Evolu's local SQLite). Same pattern
# as evolu-app.gorrdy.cz on this host.

server {
    listen 80;
    listen [::]:80;
    server_name jednadvacet.gorrdy.cz;
    # Certbot will add HTTPS redirect here.

    root /var/www/jednadvacet.gorrdy.cz;
    index index.html;

    # API → backend on 127.0.0.1:3021.
    location /api/ {
        proxy_pass http://127.0.0.1:3021;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    # Service worker must be served with the right scope.
    location = /sw.js {
        add_header Service-Worker-Allowed "/";
        add_header Cache-Control "no-cache";

        add_header Cross-Origin-Opener-Policy "same-origin" always;
        add_header Cross-Origin-Embedder-Policy "require-corp" always;
    }

    # Manifest / icon — short cache.
    location = /manifest.webmanifest {
        add_header Cache-Control "public, max-age=300";
        types { application/manifest+json webmanifest; }
    }

    # Long-cache hashed assets.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header Cross-Origin-Opener-Policy "same-origin" always;
        add_header Cross-Origin-Embedder-Policy "require-corp" always;
    }

    # WASM (Evolu ships SQLite WASM).
    location ~* \.wasm$ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header Cross-Origin-Opener-Policy "same-origin" always;
        add_header Cross-Origin-Embedder-Policy "require-corp" always;
        types { application/wasm wasm; }
    }

    # SPA fallback.
    location / {
        try_files $uri $uri/ /index.html;
    }

    gzip on;
    gzip_vary on;
    gzip_types text/html text/css application/javascript application/json application/wasm image/svg+xml application/manifest+json;

    # Security + OPFS headers on the main document.
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Cross-Origin-Embedder-Policy "require-corp" always;
}
